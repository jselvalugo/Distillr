# Database (Railway provides this automatically when you add a Postgres service)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# App behaviour
NODE_ENV=production
ALLOW_REMOTE=true
LOCAL_ONLY_MODE=false
SEED_DEMO_DATA=false

# First admin user (created on first boot if no users exist)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# Multi-tenant platform management
# Used to protect the /api/platform/tenants endpoints (create/manage tenants)
# Generate with: openssl rand -hex 32
SUPER_ADMIN_KEY=change-me-to-a-random-secret

# Transactional email (Resend) — used by the manual "Send welcome email" button in /admin
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend
EMAIL_FROM="Distillr <hello@distillrsoftware.com>"
EMAIL_REPLY_TO=support@distillrsoftware.com
# Origin used for links in emails (falls back to Netlify's URL, then https://distillrsoftware.com)
APP_BASE_URL=https://distillrsoftware.com
